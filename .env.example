PROJECT_NAME="HackTX 26"
FASTAPI_ENV=development
FRONTEND_HOST=http://localhost:8081
# Shared: the Timescale Cloud connection string, pasted as-is (postgres://...?sslmode=require)
# Local: docker compose up -d   (pgvector on 5433)
DATABASE_URL=postgresql+psycopg://hacktx:hacktx@localhost:5433/hacktx
# Tests always use this server, never DATABASE_URL
# TEST_DATABASE_URL=postgresql+psycopg://hacktx:hacktx@localhost:5433/hacktx
# Meta Model API (OpenAI-compatible)
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
LLM_MODEL=muse-spark-1.3
LLM_REASONING_EFFORT=minimal
# Feature 1 embeddings: Bedrock Titan v2 via the default AWS credential chain (aws configure)
# AWS_REGION=us-east-1
# SENTRY_DSN=
