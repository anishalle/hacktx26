PROJECT_NAME="Newcomer"
FASTAPI_ENV=development
FRONTEND_HOST=http://localhost:8081
DEMO_MODE=true

# Use a separate profile for account 407902218075.
# The discovery helper writes these to gitignored .env.aws.local.
AWS_REGION=us-east-1
# AWS_PROFILE=hacktx
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=postgres
# DATABASE_SECRET_ARN=

# Alternative to the existing RDS secret/host configuration:
# DATABASE_URL=postgresql://user:password@host:5432/newcomer?sslmode=require

BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Set an enabled Claude model ID or inference profile ID/ARN from your account:
BEDROCK_CLAUDE_MODEL_ID=
RETRIEVAL_HITS=3
CONTEXT_MAX_CHARS=240000
# SENTRY_DSN=
